{
  "name": "mifiel/api-client",
  "description": "Mifiel API Client for PHP",
  "version": "4.0.0",
  "keywords": [
    "Firma electrónica",
    "Firma electrónica Avanzada",
    "Firma documentos electrónicos",
    "FIEL",
    "Mifiel"
  ],
  "type": "library",
  "require": {
    "php": ">=8.3",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "php-coveralls/php-coveralls": "^2.2",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {"Mifiel\\": "src/"}
  },
  "autoload-dev": {
    "psr-4": {
      "Mifiel\\Tests\\": "tests/",
      "Mifiel\\Tests\\Integration\\": "tests/integration/"
    }
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Mifiel Team and Contributors",
      "email": "hola@mifiel.com",
      "homepage": "https://www.mifiel.com",
      "role": "Publisher"
    },
    {
      "name": "Genaro Madrid",
      "email": "genmadrid@gmail.com"
    }
  ]
}
